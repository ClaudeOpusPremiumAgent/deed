# Build and test environment. Only this project directory is mounted, nothing else from the host.
FROM rust:1.99.1-slim-trixie
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config libssl-dev libudev-dev curl ca-certificates git xz-utils \
  && rm -rf /var/lib/apt/lists/*
RUN rustup target add wasm32-unknown-unknown && rustup component add rust-src
RUN curl -fsSL https://github.com/near/cargo-near/releases/download/cargo-near-v0.22.0/cargo-near-x86_64-unknown-linux-gnu.tar.gz \
    | tar -xz --strip-components=1 -C /usr/local/bin cargo-near-x86_64-unknown-linux-gnu/cargo-near
WORKDIR /app
